#!/usr/bin/env bash

set -euo pipefail

profile="${NOTARYTOOL_PROFILE:-zed-zh-hant-notary}"
api_key_path="${APPLE_NOTARIZATION_KEY_PATH:-}"
api_key_id="${APPLE_NOTARIZATION_KEY_ID:-}"
api_issuer="${APPLE_NOTARIZATION_ISSUER_ID:-}"
apple_id="${APPLE_ID:-${AC_USERNAME:-}}"
apple_password="${AC_PASSWORD:-}"
team_id="${APPLE_TEAM_ID:-${TEAM_ID:-}}"
keychain_path=""
sync=false
validate=true
dry_run=false

print_help() {
    cat <<'EOF'
Usage: script/store-mac-notary-credentials [options]

Store Apple notarization credentials in Keychain for later use by
script/notarize-mac-release.

Options:
  -p, --profile NAME        notarytool keychain profile name.
                            Defaults to zed-zh-hant-notary.
  -k, --key PATH            App Store Connect API key .p8 path.
  -d, --key-id ID           App Store Connect API key id.
  -i, --issuer ID           App Store Connect issuer id.
  -u, --apple-id ID         Apple ID for app-specific password auth.
  -w, --password PASSWORD   App-specific password. Prefer omitting this so
                            notarytool can prompt securely.
  -t, --team-id ID          Apple Developer Team ID for Apple ID auth.
      --keychain PATH       Keychain file to store the profile in.
      --sync                Store in iCloud Keychain / Local Items.
      --no-validate         Save without validating with Apple immediately.
      --dry-run             Print selected mode without storing credentials.
  -h, --help                Show this help.

Supported environment variables:
  NOTARYTOOL_PROFILE
  APPLE_NOTARIZATION_KEY_PATH
  APPLE_NOTARIZATION_KEY_ID
  APPLE_NOTARIZATION_ISSUER_ID
  APPLE_ID or AC_USERNAME
  AC_PASSWORD
  APPLE_TEAM_ID or TEAM_ID
EOF
}

die() {
    echo "error: $*" >&2
    exit 2
}

redact_command() {
    local item
    for item in "$@"; do
        if [[ "$item" = "$apple_password" && -n "$apple_password" ]]; then
            printf '%q ' "<redacted>"
        else
            printf '%q ' "$item"
        fi
    done
    printf '\n'
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -p|--profile)
            profile="${2:-}"
            shift 2
            ;;
        -k|--key)
            api_key_path="${2:-}"
            shift 2
            ;;
        -d|--key-id)
            api_key_id="${2:-}"
            shift 2
            ;;
        -i|--issuer)
            api_issuer="${2:-}"
            shift 2
            ;;
        -u|--apple-id)
            apple_id="${2:-}"
            shift 2
            ;;
        -w|--password)
            apple_password="${2:-}"
            shift 2
            ;;
        -t|--team-id)
            team_id="${2:-}"
            shift 2
            ;;
        --keychain)
            keychain_path="${2:-}"
            shift 2
            ;;
        --sync)
            sync=true
            shift
            ;;
        --no-validate)
            validate=false
            shift
            ;;
        --dry-run)
            dry_run=true
            shift
            ;;
        -h|--help)
            print_help
            exit 0
            ;;
        *)
            die "unknown option: $1"
            ;;
    esac
done

[[ -n "$profile" ]] || die "profile name is required"

if ! command -v xcrun >/dev/null 2>&1; then
    die "xcrun is required"
fi

if [[ "$sync" = true && -n "$keychain_path" ]]; then
    die "--sync and --keychain cannot be used together"
fi

cmd=(xcrun notarytool store-credentials "$profile")
mode=""

if [[ -n "$api_key_path" || -n "$api_key_id" || -n "$api_issuer" ]]; then
    [[ -n "$api_key_path" ]] || die "APPLE_NOTARIZATION_KEY_PATH or --key is required for API key credential storage"
    [[ -f "$api_key_path" ]] || die "API key file does not exist: $api_key_path"
    [[ -n "$api_key_id" ]] || die "APPLE_NOTARIZATION_KEY_ID or --key-id is required for API key credential storage"

    mode="App Store Connect API key"
    cmd+=(--key "$api_key_path" --key-id "$api_key_id")
    if [[ -n "$api_issuer" ]]; then
        cmd+=(--issuer "$api_issuer")
    fi
elif [[ -n "$apple_id" || -n "$apple_password" || -n "$team_id" ]]; then
    [[ -n "$apple_id" ]] || die "APPLE_ID, AC_USERNAME, or --apple-id is required for Apple ID credential storage"
    [[ -n "$team_id" ]] || die "APPLE_TEAM_ID, TEAM_ID, or --team-id is required for Apple ID credential storage"

    mode="Apple ID app-specific password"
    cmd+=(--apple-id "$apple_id" --team-id "$team_id")
    if [[ -n "$apple_password" ]]; then
        cmd+=(--password "$apple_password")
    fi
else
    die "no credentials selected; provide API key options or Apple ID/team options"
fi

if [[ "$sync" = true ]]; then
    cmd+=(--sync)
fi

if [[ -n "$keychain_path" ]]; then
    cmd+=(--keychain "$keychain_path")
fi

if [[ "$validate" = false ]]; then
    cmd+=(--no-validate)
fi

echo "Profile: $profile"
echo "Credential mode: $mode"

if [[ "$dry_run" = true ]]; then
    echo "Dry run: not storing credentials."
    echo -n "Would run: "
    redact_command "${cmd[@]}"
    exit 0
fi

echo "Storing credentials with notarytool..."
"${cmd[@]}"

echo "Credentials stored. Use them with:"
echo "  script/notarize-mac-release --profile $profile"
